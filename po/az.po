#. TRANSLATORS: This is the label for an keyring created without a label
#: daemon/dbus/gkd-secret-change.c:84 daemon/dbus/gkd-secret-change.c:120
#: daemon/dbus/gkd-secret-create.c:78
#: daemon/ssh-agent/gkd-ssh-agent-service.c:254
#: pkcs11/secret-store/gkm-secret-collection.c:324
#: pkcs11/wrap-layer/gkm-wrap-login.c:345
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:672
msgid "Unnamed"
msgstr "Adsız"

#: daemon/dbus/gkd-secret-change.c:89
#, c-format
msgid "Enter the old password for the “%s” keyring"
msgstr "“%s” şifrə kisəsi üçün köhnə şifrəni daxil edin"

#: daemon/dbus/gkd-secret-change.c:93
#, c-format
msgid ""
"An application wants to change the password for the “%s” keyring. Enter the "
"old password for it."
msgstr ""
"Bir tətbiq “%s” şifrə kisəsinin şifrəsini dəyişdirmək istəyir. Bunun üçün "
"onun köhnə şifrəsini daxil edin."

#: daemon/dbus/gkd-secret-change.c:99 daemon/dbus/gkd-secret-change.c:135
#: daemon/dbus/gkd-secret-change.c:146 pkcs11/wrap-layer/gkm-wrap-prompt.c:1079
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:1192
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:1227
msgid "Continue"
msgstr "Davam et"

#: daemon/dbus/gkd-secret-change.c:125
#, c-format
msgid "Choose a new password for the “%s” keyring"
msgstr "“%s” şifrə kisəsi üçün yeni şifrə seçin"

#: daemon/dbus/gkd-secret-change.c:129
#, c-format
msgid ""
"An application wants to change the password for the “%s” keyring. Choose the "
"new password you want to use for it."
msgstr ""
"Bir tətbiq “%s” şifrə kisəsinin şifrəsini dəyişdirmək istəyir. Onun üçün "
"istifadə etmək istədiyiniz yeni şifrəni seçin."

#: daemon/dbus/gkd-secret-change.c:142 daemon/dbus/gkd-secret-create.c:94
msgid "Store passwords unencrypted?"
msgstr "Şifrələr şifrələnmədən yadda saxlanılsın?"

#: daemon/dbus/gkd-secret-change.c:144 daemon/dbus/gkd-secret-create.c:96
msgid ""
"By choosing to use a blank password, your stored passwords will not be "
"safely encrypted. They will be accessible by anyone with access to your "
"files."
msgstr ""
"Boş şifrə istifadə etməyi seçməklə yadda saxlanılan şifrələriniz təhlükəsiz "
"şəkildə şifrələnməyəcək. Onlar fayllarınıza çıxışı olan hər kəs üçün əlçatan "
"olacaq."

#: daemon/dbus/gkd-secret-change.c:152
msgid "The original password was incorrect"
msgstr "Orijinal şifrə yanlış idi"

#: daemon/dbus/gkd-secret-change.c:348
msgid "Change Keyring Password"
msgstr "Şifrə Kisəsi Şifrəsini Dəyişdir"

#: daemon/dbus/gkd-secret-create.c:80
#, c-format
msgid ""
"An application wants to create a new keyring called “%s”. Choose the "
"password you want to use for it."
msgstr ""
"Bir tətbiq “%s” adlı yeni bir şifrə kisəsi yaratmaq istəyir. Onun üçün "
"istifadə etmək istədiyiniz şifrəni seçin."

#: daemon/dbus/gkd-secret-create.c:84
msgid "Choose password for new keyring"
msgstr "Yeni şifrə kisəsi üçün şifrəni seçin"

#: daemon/dbus/gkd-secret-create.c:309
msgid "New Keyring Password"
msgstr "Yeni Şifrə Kisəsi Şifrəsi"

#. TRANSLATORS: '%s' is an application id, for example "org.gnome.Maps"
#: daemon/dbus/gkd-secret-portal.c:382
#, c-format
msgid "Application key for %s"
msgstr "%s üçün tətbiq açarı"

#: daemon/gnome-keyring-pkcs11.desktop.in.in:3
msgid "Certificate and Key Storage"
msgstr "Sertifikat və Açar Saxlanma Yeri"

#: daemon/gnome-keyring-pkcs11.desktop.in.in:4
msgid "GNOME Keyring: PKCS#11 Component"
msgstr "GNOME Şifrə Kisəsi: PKCS#11 Komponenti"

#: daemon/gnome-keyring-secrets.desktop.in.in:3
msgid "Secret Storage Service"
msgstr "Məxfi Saxlama Xidməti"

#: daemon/gnome-keyring-secrets.desktop.in.in:4
msgid "GNOME Keyring: Secret Service"
msgstr "GNOME Şifrə Kisəsi: Məxfi Xidmət"

#: daemon/gnome-keyring-ssh.desktop.in.in:3
msgid "SSH Key Agent"
msgstr "SSH Açar Agenti"

#: daemon/gnome-keyring-ssh.desktop.in.in:4
msgid "GNOME Keyring: SSH Agent"
msgstr "GNOME Şifrə Kisəsi: SSH Agenti"

#. TRANSLATORS: This is the display label for the login keyring
#: daemon/login/gkd-login.c:165
msgid "Login"
msgstr "Giriş"

#. Get the label ready
#: daemon/login/gkd-login-interaction.c:191
#: pkcs11/wrap-layer/gkm-wrap-login.c:345
#, c-format
msgid "Unlock password for: %s"
msgstr "Bunun üçün qıfılaçma şifrəsi: %s"

#: daemon/ssh-agent/gkd-ssh-agent-interaction.c:100
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:573
msgid "Unlock private key"
msgstr "Məxfi açarın qıfılını aç"

#: daemon/ssh-agent/gkd-ssh-agent-interaction.c:101
msgid "Enter password to unlock the private key"
msgstr "Məxfi açarın qıfılını açmaq üçün şifrəni daxil edin"

#. TRANSLATORS: The private key is locked
#: daemon/ssh-agent/gkd-ssh-agent-interaction.c:104
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:604
#, c-format
msgid "An application wants access to the private key “%s”, but it is locked"
msgstr "Bir tətbiq “%s” məxfi açarına çıxış istəyir, lakin o, qıfıllıdır"

#: daemon/ssh-agent/gkd-ssh-agent-interaction.c:111
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:589
msgid "Automatically unlock this key whenever I’m logged in"
msgstr "Mən daxil olanda həmişə bu açarın qıfılını avtomatik aç"

#: daemon/ssh-agent/gkd-ssh-agent-interaction.c:113
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:539
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:564
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:579
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:640
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:686
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:718
msgid "Unlock"
msgstr "Kilidi aç"

#: daemon/ssh-agent/gkd-ssh-agent-interaction.c:116
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:684
msgid "The unlock password was incorrect"
msgstr "Kilidaçma şifrəsi yanlış idi"

#: egg/dotlock.c:668
#, c-format
msgid "failed to create temporary file `%s': %s\n"
msgstr "`%s` müvəqqəti faylı yaradıla bilmədi: %s\n"

#: egg/dotlock.c:718
#, c-format
msgid "error writing to `%s': %s\n"
msgstr "`%s` faylına yazma xətası: %s\n"

#: egg/dotlock.c:782
#, c-format
msgid "can't create `%s': %s\n"
msgstr "`%s` yaradıla bilmir: %s\n"

#. Note: It is unlikley that we get a race here unless a pid is
#. reused too fast or a new process with the same pid as the one
#. of the stale file tries to lock right at the same time as we.
#: egg/dotlock.c:1048
#, c-format
msgid "removing stale lockfile (created by %d)\n"
msgstr "köhnəlmiş kilid faylı silinir (%d tərəfindən yaradılmışdı)\n"

#: egg/dotlock.c:1084
#, c-format
msgid "waiting for lock (held by %d%s) %s...\n"
msgstr "kilid gözlənilir (%d%s tərəfindən saxlanılır) %s...\n"

#: egg/dotlock.c:1085
msgid "(deadlock?) "
msgstr "(çıxılmaz vəziyyət?) "

#: egg/dotlock.c:1124
#, c-format
msgid "lock `%s' not made: %s\n"
msgstr "`%s` kilidi edilmədi: %s\n"

#: egg/dotlock.c:1150
#, c-format
msgid "waiting for lock %s...\n"
msgstr "%s kilidi gözlənilir...\n"

